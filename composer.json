{
    "name": "kalodiodev/send2link-laravel-client",
    "description": "send2link.eu Url Shortener client",
    "version": "1.2.0",
    "minimum-stability" : "dev",
    "prefer-stable" : true,
    "authors": [
        {
            "name": "Athanasios Raptodimos"
        }
    ],
    "autoload": {
        "psr-4": {
            "Kalodiodev\\Send2Link\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kalodiodev\\Send2Link\\Tests\\": "tests/"
        }
    },
    "require": {
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/contracts": "^10.0|^11.0|^12.0",
        "illuminate/http": "^9.0|^10.0|^11.0|^12.0",
        "guzzlehttp/guzzle": "^7.0",
        "illuminate/events": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5|^11.0|^12",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^8.0|^9.0|^10.9"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Kalodiodev\\Send2Link\\Send2LinkServiceProvider"
            ]
        }
    }
}
